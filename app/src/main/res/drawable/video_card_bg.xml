<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6639FF14" />
                    <corners android:radius="12dp" />
                    <stroke android:width="4dp" android:color="#FF39FF14" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_focused" />
                    <corners android:radius="10dp" />
                    <stroke android:width="2dp" android:color="#FF00E5FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF2A2A2A" />
        </shape>
    </item>
</selector>
